syntax = "v1"

info (
	title:   "OnlineCar Gateway API"
	desc:    "网约车平台API网关"
	version: "1.0"
)

// ========== 司机 ==========
type (
	DriverRegisterReq {
		Name           string `json:"name"`
		Phone          string `json:"phone"`
		Code           string `json:"code"`
		VehicleNo      string `json:"vehicleNo"`
		VehicleType    string `json:"vehicleType"`
		CommercialType int64  `json:"commercialType,optional"`
	}
	DriverLoginReq {
		Phone string `json:"phone"`
		Code  string `json:"code"`
	}
	DriverLocationReq {
		Lng float64 `json:"lng"`
		Lat float64 `json:"lat"`
	}
	DriverResp {
		Id             int64  `json:"id"`
		Name           string `json:"name"`
		Phone          string `json:"phone"`
		VehicleNo      string `json:"vehicleNo"`
		VehicleType    string `json:"vehicleType"`
		Brand          string `json:"brand"`
		Model          string `json:"model"`
		CommercialType int64  `json:"commercialType"`
		State          int64  `json:"state"`
		WorkStatus     int64  `json:"workStatus"`
	}
	DriverWorkStatusReq {
		WorkStatus int64 `json:"workStatus"`
	}
	DriverWorkStatusResp {
		DriverId   int64 `json:"driverId"`
		WorkStatus int64 `json:"workStatus"`
	}
)

// ========== 乘客 ==========
type (
	PassengerRegisterReq {
		Name   string `json:"name"`
		Phone  string `json:"phone"`
		Code   string `json:"code"`
		Gender int64  `json:"gender,optional"`
	}
	PassengerLoginReq {
		Phone string `json:"phone"`
		Code  string `json:"code"`
	}
	PassengerResp {
		Id           int64  `json:"id"`
		Name         string `json:"name"`
		Phone        string `json:"phone"`
		Gender       int64  `json:"gender"`
		State        int64  `json:"state"`
		ProfilePhoto string `json:"profilePhoto"`
	}
)

// ========== 短信验证码 ==========
type (
	SendSmsReq {
		Phone string `json:"phone"`
	}
)

// ========== 行程 ==========
type (
	CreateTripReq {
		Origin      string  `json:"origin"`
		Destination string  `json:"destination"`
		OriginLng   float64 `json:"originLng"`
		OriginLat   float64 `json:"originLat"`
		DestLng     float64 `json:"destLng"`
		DestLat     float64 `json:"destLat"`
	}
	TripResp {
		Id          int64  `json:"id"`
		PassengerId int64  `json:"passengerId"`
		DriverId    int64  `json:"driverId"`
		Origin      string `json:"origin"`
		Destination string `json:"destination"`
		Status      int64  `json:"status"`
		Fare        string `json:"fare"` // 金额(元)，字符串格式避免浮点精度丢失，如 "12.34"
	}
)

// ========== 公开路由 ==========

@server (
	prefix: /api/v1
	group:  driver
)
service gateway-api {
	@handler DriverRegister
	post /driver/register (DriverRegisterReq)

	@handler DriverLogin
	post /driver/login (DriverLoginReq)

	@handler DriverSendSms
	post /driver/sms/send (SendSmsReq)
}

@server (
	prefix: /api/v1
	group:  passenger
)
service gateway-api {
	@handler PassengerRegister
	post /passenger/register (PassengerRegisterReq)

	@handler PassengerLogin
	post /passenger/login (PassengerLoginReq)

	@handler PassengerSendSms
	post /passenger/sms/send (SendSmsReq)
}

// ========== 司机认证路由 ==========

@server (
	prefix: /api/v1
	group:  driver
	jwt:    AuthDriver
)
service gateway-api {
	@handler UpdateDriverLocation
	post /driver/location (DriverLocationReq)
}

// ========== 乘客认证路由 ==========

@server (
	prefix: /api/v1
	group:  trip
	jwt:    AuthPassenger
)
service gateway-api {
	@handler CreateTrip
	post /trip (CreateTripReq)
}
